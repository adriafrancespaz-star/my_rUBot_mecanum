<?xml version="1.0" ?>
<sdf version="1.7">
    <world name="groupB3_custom">

        <physics name="default_physics" type="ode">
            <max_step_size>0.005</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>200</real_time_update_rate>
        </physics>

        <!-- Core Ignition systems (Fortress / Gazebo6) -->
        <plugin filename="libignition-gazebo6-physics-system.so"
                name="ignition::gazebo::systems::Physics"/>

        <plugin filename="libignition-gazebo6-user-commands-system.so"
                name="ignition::gazebo::systems::UserCommands"/>

        <plugin filename="libignition-gazebo6-scene-broadcaster-system.so"
                name="ignition::gazebo::systems::SceneBroadcaster"/>

        <plugin filename="libignition-gazebo6-sensors-system.so"
                name="ignition::gazebo::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <!-- Scene configuration -->
        <scene>
            <ambient>0.6 0.6 0.6 1</ambient>
            <background>0.8 0.8 0.8 1</background>
            <shadows>false</shadows>
            <grid>true</grid>
        </scene>

        <!-- Sun light -->
        <light type="directional" name="sun">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Ground plane -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>20 20</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>20 20</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Gazebo Fortress GUI -->
        <gui fullscreen="0">
            <plugin filename="MinimalScene" name="3D View">
                <gz-gui>
                    <title>3D View</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="string" key="state">docked</property>
                </gz-gui>
                <engine>ogre2</engine>
                <scene>scene</scene>
                <camera_pose>0.7 0 4.5 0 1.5708 0</camera_pose>
            </plugin>

            <plugin filename="GzSceneManager" name="Scene Manager">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">1</property>
                    <property key="height" type="double">1</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>

            <plugin filename="InteractiveViewControl" name="Interactive view control">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">1</property>
                    <property key="height" type="double">1</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>

            <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">1</property>
                    <property key="height" type="double">1</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>

            <plugin filename="CameraTracking" name="Camera Tracking">
                <gz-gui>
                    <property key="width" type="double">1</property>
                    <property key="height" type="double">1</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>

            <plugin filename="ComponentInspector" name="Component inspector"/>
            <plugin filename="EntityTree" name="Entity tree"/>
        </gui>

        <!-- ==================== PERCEPTION SIGN ==================== -->
        <include>
            <uri>model://sign_left_ign</uri>
            <name>traffic_sign_b3</name>
            <pose>0.7 -0.6 0 0 0 1.57</pose>
        </include>

        <!-- ==================== OUTER BOUNDARY (3.6m x 3.6m) ==================== -->
        <!-- Right wall (x = 2.5) -->
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_east_mid</name>
            <pose>2.5 0 0.15 0 0 1.5708</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_east_north</name>
            <pose>2.5 1.2 0.15 0 0 1.5708</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_east_south</name>
            <pose>2.5 -1.2 0.15 0 0 1.5708</pose>
        </include>

        <!-- Top wall (y = 1.8) -->
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_north_east</name>
            <pose>1.9 1.8 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_north_mid</name>
            <pose>0.7 1.8 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_north_west</name>
            <pose>-0.5 1.8 0.15 0 0 0</pose>
        </include>

        <!-- Bottom wall (y = -1.8) -->
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_south_east</name>
            <pose>1.9 -1.8 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_south_mid</name>
            <pose>0.7 -1.8 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_south_west</name>
            <pose>-0.5 -1.8 0.15 0 0 0</pose>
        </include>

        <!-- Left wall (x = -1.1) -->
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_west_mid</name>
            <pose>-1.1 0 0.15 0 0 1.5708</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_west_north</name>
            <pose>-1.1 1.2 0.15 0 0 1.5708</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>outer_west_south</name>
            <pose>-1.1 -1.2 0.15 0 0 1.5708</pose>
        </include>

        <!-- ==================== INTERNAL OBSTACLES ====================
             Every internal wall is anchored at BOTH ends (outer wall or another internal wall).
             The openings are doorways in the middle of the walls, away from the boundaries. -->

        <!-- Horizontal divider at y = 0.6, from west wall (x=-1.1) to east wall (x=2.5).
             Doorway: x = -0.10 .. 0.70 (0.8 m wide). -->
        <include>
            <uri>model://wall60cm</uri>
            <name>h_div_west_a</name>
            <pose>-0.82 0.6 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://wall90cm</uri>
            <name>h_div_west_b</name>
            <pose>-0.55 0.6 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://wall90cm</uri>
            <name>h_div_east_a</name>
            <pose>1.15 0.6 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://wall120cm</uri>
            <name>h_div_east_b</name>
            <pose>1.92 0.6 0.15 0 0 0</pose>
        </include>

        <!-- Vertical divider at x = 1.3, from bottom wall (y=-1.8) up to the horizontal divider.
             Doorway: y = -0.92 .. 0.02 (0.94 m wide). -->
        <include>
            <uri>model://wall90cm</uri>
            <name>v_div_lower</name>
            <pose>1.3 -1.37 0.15 0 0 1.5708</pose>
        </include>
        <include>
            <uri>model://wall60cm</uri>
            <name>v_div_upper</name>
            <pose>1.3 0.32 0.15 0 0 1.5708</pose>
        </include>

    </world>
</sdf>