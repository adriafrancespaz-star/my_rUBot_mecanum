<?xml version="1.0"?>
<launch>
    <!-- Navigation Program   -->
    <arg name="distance_limit" default="0.4"/>
    <arg name="speed_factor" default="1.0"/>
    <arg name="forward_speed" default="0.3"/>
    <arg name="rotation_speed" default="0.5"/>

    <node
        pkg="my_robot_control" exec="my_robot_selfcontrol_exec" name="robot_selfcontrol_node" output="screen">
            <param name="distance_limit" value="$(var distance_limit)"/>
            <param name="speed_factor" value="$(var speed_factor)"/>
            <param name="forward_speed" value="$(var forward_speed)"/>
            <param name="rotation_speed" value="$(var rotation_speed)"/>
    </node>
</launch>
